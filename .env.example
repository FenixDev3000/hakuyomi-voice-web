# URL de la API (entra en el build). Local: la API del Docker del PC.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# Token de prueba (mismo valor que API_AUTH_TOKEN de la API). Queda visible en el bundle.
VITE_API_AUTH_TOKEN=<REPLACE_WITH_TEST_API_TOKEN>

# Publicación en el host (puerto y bind los asigna Miyo para la VM)
WEB_BIND=127.0.0.1
WEB_PORT=5173
